FROM --platform=$BUILDPLATFORM public.ecr.aws/docker/library/golang:1.26-alpine AS builder

RUN apk add --no-cache 'git>=2.47'

ARG CI_SERVER_HOST

WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=secret,id=netrc,target=/root/.netrc \
    go env -w "GOPRIVATE=${CI_SERVER_HOST}" && \
    go mod download

COPY . .
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -ldflags "-s -w -X 'gitlab.com/crusoeenergy/island/managed-platform-services/crusoe-watch-agent-v2/internal/version.Version=${VERSION}'" \
    -o /report-runner ./cmd/report-runner

# nvidia-bug-report.sh ships with nvidia-utils. In the CUDA repo, nvidia-utils-570
# and later are empty transitional packages, so the branch stays at 565.
FROM public.ecr.aws/docker/library/ubuntu:24.04
ARG NVIDIA_DRIVER_BRANCH=565
ARG TARGETARCH
# The tools need only libnvidia-ml; skip the CUDA, OpenCL and video libraries.
RUN case "${TARGETARCH}" in amd64) repo_arch=x86_64 ;; arm64) repo_arch=sbsa ;; *) exit 1 ;; esac \
    && apt-get update && apt-get install -y --no-install-recommends wget ca-certificates \
    && wget --https-only --tries=3 --timeout=30 -qO /tmp/cuda-keyring.deb \
        "https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/${repo_arch}/cuda-keyring_1.1-1_all.deb" \
    && dpkg -i /tmp/cuda-keyring.deb \
    && rm -f /tmp/cuda-keyring.deb \
    && printf 'path-exclude=/usr/lib/*/%s\n' \
        'libcuda.so*' 'libcudadebugger.so*' 'libnvidia-nvvm.so*' 'libnvidia-ptxjitcompiler.so*' \
        'libnvidia-gpucomp.so*' 'libnvidia-opencl.so*' 'libnvcuvid.so*' \
        > /etc/dpkg/dpkg.cfg.d/excludes-nvidia \
    && apt-get update && apt-get install -y --no-install-recommends \
        "nvidia-utils-${NVIDIA_DRIVER_BRANCH}" \
        pciutils usbutils dmidecode kmod util-linux procps iproute2 gzip \
    && apt-get purge -y --auto-remove wget \
    && rm -rf /var/lib/apt/lists/*
# Read by the nvidia container runtime.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
COPY --from=builder /report-runner /usr/local/bin/report-runner
ENTRYPOINT ["/usr/local/bin/report-runner"]
