[Unit]
Description=CWA Updater - Crusoe Watch Agent upgrade executor
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/crusoe/crusoe_watch_agent/.env
WorkingDirectory=/etc/crusoe/crusoe_watch_agent
ExecStart=@@EXEC_START@@
ExecStop=@@EXEC_STOP@@
TimeoutStartSec=0
TimeoutStopSec=30
# A stop mid-upgrade is the interrupted case cwa-updater recovers from on start.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
